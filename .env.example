# ==============================================================================
# MPLAD SENTINEL — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. GROQ LLM API (Optional - Activates Live LLaMA 3.3 70B AI Reasoning)
# Get your free API key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# 2. SUPABASE CLOUD BACKEND (Optional - Activates Persistent PostGIS & WebSockets)
# Create a free project at: https://supabase.com
# Execute SQL from: supabase/full_schema_and_seed.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 3. RUNTIME FEATURE FLAGS
VITE_ENABLE_ML_ANOMALY_ENGINE=true
VITE_ENABLE_DOCUMENT_OCR=true
VITE_ENABLE_DEMO_MODE=true
